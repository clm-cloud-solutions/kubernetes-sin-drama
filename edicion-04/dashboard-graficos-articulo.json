      "id": 1,
      "type": "timeseries",
      "title": "Eventos guardados: API server frente a Loki",
      "description": "API server: apiserver_storage_objects{resource=\"events\"} (los borra a la hora, --event-ttl). Loki: eventos de las últimas 72 h (su retención).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(apiserver_storage_objects{resource=\"events\"})",
          "legendFormat": "API server · TTL 1 h",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"loki.source.kubernetes_events\"}[72h]))",
          "legendFormat": "Loki · retención 72 h",
          "queryType": "range",
          "step": "5m"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
